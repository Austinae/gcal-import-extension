{
  "manifest_version": 3,
  "name": "GCal Quick Import",
  "version": "0.1.1",
  "description": "Drop an .ics file onto Google Calendar to import it without digging through Settings.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://calendar.google.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GCal Quick Import",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}